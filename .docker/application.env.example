# Local HTTP only. Copy to application.env and replace SESSION_SECRET.
NODE_ENV=development
DATABASE_URL=postgresql://cubity:cubity-local-demo@db:5432/cubity_support
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=28800
APP_ORIGIN=http://127.0.0.1:8080
TRUSTED_PROXY_IPS=
SEED_DEMO=true
