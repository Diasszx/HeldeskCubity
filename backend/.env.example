NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://cubity:cubity-local-demo@127.0.0.1:5432/cubity_support
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=28800
APP_ORIGIN=http://127.0.0.1:3000
TRUSTED_PROXY_IPS=
# NestJS Observe is opt-in. Enabling sends telemetry to the configured collector.
OBSERVE_ENABLED=false
# Supply the key pair from your Observe project only when enabling.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=cubity-support-api
OBSERVE_SERVICE_VERSION=0.1.0
OBSERVE_ENDPOINT=https://observe-api.nestjs.com
OBSERVE_SAMPLE_RATE=1
